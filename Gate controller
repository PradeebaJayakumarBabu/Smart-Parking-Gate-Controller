
#include <stdio.h>
#include <stdlib.h>
#include <semaphore.h>
#include <errno.h>

int main()
{
    sem_t parking;
    int capacity;
    int choice;
    int occupied = 0;

    printf("\n====================================\n");
    printf("   SMART PARKING GATE CONTROLLER\n");
    printf("       COUNTING SEMAPHORE\n");
    printf("====================================\n");

    printf("\nEnter total parking capacity: ");
    scanf("%d", &capacity);

    if (capacity <= 0)
    {
        printf("Invalid parking capacity!\n");
        return 1;
    }

    // Initialize counting semaphore
    if (sem_init(&parking, 0, capacity) != 0)
    {
        perror("Semaphore initialization failed");
        return 1;
    }

    do
    {
        printf("\n----------- PARKING MENU -----------\n");
        printf("1. Vehicle Entry\n");
        printf("2. Vehicle Exit\n");
        printf("3. Display Parking Status\n");
        printf("4. Exit Program\n");
        printf("------------------------------------\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                // Request one parking space
                if (sem_trywait(&parking) == 0)
                {
                    occupied++;
                    printf("\nVehicle entered successfully!");
                    printf("\nGate Status: OPEN\n");
                }
                else if (errno == EAGAIN)
                {
                    printf("\nParking is FULL!");
                    printf("\nGate Status: CLOSED\n");
                    printf("Vehicle entry denied.\n");
                }
                else
                {
                    perror("Semaphore error");
                }
                break;

            case 2:
                if (occupied > 0)
                {
                    // Release one parking space
                    sem_post(&parking);
                    occupied--;

                    printf("\nVehicle exited successfully!");
                    printf("\nParking space released.\n");
                }
                else
                {
                    printf("\nParking lot is already EMPTY!");
                    printf("\nNo vehicle available to exit.\n");
                }
                break;

            case 3:
                printf("\nParking Status Display\n");
                break;

            case 4:
                printf("\nClosing Parking Controller...\n");
                break;

            default:
                printf("\nInvalid choice! Try again.\n");
                break;
        }

        if (choice >= 1 && choice <= 3)
        {
            printf("\n========== PARKING STATUS ==========\n");
            printf("Total Spaces     : %d\n", capacity);
            printf("Occupied Spaces  : %d\n", occupied);
            printf("Available Spaces : %d\n", capacity - occupied);

            if (occupied == capacity)
                printf("Status           : FULL\n");
            else if (occupied == 0)
                printf("Status           : EMPTY\n");
            else
                printf("Status           : SPACES AVAILABLE\n");

            printf("====================================\n");
        }

    } while (choice != 4);

    sem_destroy(&parking);

    return 0;
}
